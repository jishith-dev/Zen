# Zen modules
#
# A module may export functions, thread functions, global values,
# fixed-size arrays, and user-defined structs.
#
# Multiple import and export declarations are allowed. Export names
# from all declarations are combined. Only explicitly exported
# symbols are visible to importing modules.


# Multiple imports from the same module

import (add) from "module_basic.zen"
import (mul) from "module_basic.zen"

add()
mul()


# Multiple names in one import

import (getSquare, getCube) from "module_basic.zen"

getSquare(5)
getCube(3)


# Exported global values

import (answer) from "module_basic.zen"
import (message) from "module_basic.zen"

screen(answer)
screen(message)


# Exported fixed-size array

import (numbers) from "module_basic.zen"

screen(numbers[0])
screen(numbers[1])
screen(numbers[2])


# Multiple exports from one module

import (first, second) from "module_nested.zen"
import (third, fourth) from "module_nested.zen"

screen(first)
screen(second)
screen(third)
screen(fourth)


# Aliased imports (functions and variables only)

import (add as plus, getSquare as sq) from "module_basic.zen"
import (answer as theAnswer, message as greeting) from "module_basic.zen"

plus()
sq(6)
screen(theAnswer)
screen(greeting)


# Exported function that uses a private function internally
# (the private function itself is not visible here)

import (callHelper) from "module_basic.zen"

callHelper()


# Exported thread function

import (worker) from "module_basic.zen"
import (worker as w) from "module_basic.zen"

worker(1)
w(2)
threads.waitAll()


# Exported user-defined struct

import (Person) from "module_struct.zen"

Person person = {
  name: "Jishith",
  age: 21
}

screen(person.name)
screen(person.age)


# Struct methods, private fields/methods and thread methods

import (User) from "module_struct.zen"

User user = {
  name: "Zen"
}

user.greet("Jishith")

# Public method that uses a private field and a private method
user.setSecret(7)
screen(user.revealSecret())

# Thread method
user.run(5)
threads.waitAll()


# Importing a struct implicitly imports its dependency structs
# (through fields and List<struct> fields). They are usable only
# through the imported struct and cannot be named.

import (Company) from "module_deps.zen"

Company company

company.setup("Axion Labs", "Kannur")
company.addEmployee("Achu")
company.show()

# Access through the field chain works
screen(company.address.city)
company.address.show()


# Module symbols are isolated
#
# The following are intentionally disabled because each must produce
# a compile-time error:
#
# A symbol not exported by the source module cannot be imported:
# import (privateValue) from "module_basic.zen"
#
# A symbol that does not exist cannot be imported:
# import (doesNotExist) from "module_basic.zen"
#
# Private functions cannot be exported or imported. Private
# functions are internal to their module, so exporting one is a
# compile-time error (in module_basic.zen):
# export (helper)
# import (helper) from "module_basic.zen"


# Builtin namespaces and functions cannot be exported or imported
#
# import (net) from "module_basic.zen"
# export (net)
# import (screen) from "module_basic.zen"
# export (screen)


# Duplicate imports of the same symbol must fail
#
# import (add) from "module_basic.zen"
# import (add) from "module_basic.zen"
#
# Duplicate export names must fail (in the exporting module):
# export (add)
# export (add)


# Struct aliases are not allowed
#
# Structs cannot be imported with an alias because the real names
# of their dependencies would still propagate. Compile-time
# ImportError: Struct 'Person' cannot be imported with an alias
#
# import (Person as P) from "module_struct.zen"


# Importing a non-exported struct must fail
#
# import (PrivateStruct) from "module_struct.zen"


# Private fields and methods are only accessible inside the struct
# through `this.`. Access from outside is a compile-time error.
#
# screen(user.secret)
# user.secret = 1
# user.twice()


# Implicitly imported structs cannot be used by name
#
# Importing Company implicitly imports Address and Employee as
# hidden structs. Using their names is a compile-time ReferenceError.
#
# Address a = { city: "Kannur" }
#
# Defining a local struct with the same name as a hidden struct is
# a compile-time NameError.
#
# struct Address {
#   string city
# }


# Importing an already implicitly imported struct must fail
#
# Address was already imported implicitly by Company, so importing
# it explicitly is a compile-time conflict error (in either order).
#
# import (Company) from "module_deps.zen"
# import (Address) from "module_deps.zen"


# Module path resolution
#
# A .zen source path can be imported directly. Relative paths are
# resolved from the importing source context.
#
# Installed packages can be imported using a bare package name.
#
# import (WebSocket) from "websocket"
#
# Package imports are not executed in this test because they would
# make the test depend on an installed external package.


# Zen caches compiled modules and resolves each requested symbol
# from the cached module information.


##--------- Module Files -----------##

/*
# module_basic.zen

fn add() {
  screen("called add")
}

fn mul() {
  screen("called mul")
}

fn getSquare(int value) {
  screen(value * value)
}

fn getCube(int value) {
  screen(value * value * value)
}

# Private function: internal to this module, cannot be exported
private fn helper() {
  screen("called private helper")
}

fn callHelper() {
  helper()
}

thread fn worker(int id) {
  screen("worker " + String(id))
}

const int answer = 42

string message = "Hello from module"

int numbers[3] = [10, 20, 30]

export (add)
export (mul)
export (getSquare, getCube)
export (callHelper)
export (worker)
export (answer)
export (message, numbers)

# Private functions cannot be exported (compile-time error):
# export (helper)


# module_struct.zen

struct Person {
  string name
  int age
}

struct User {
  string name
  private int secret

  greet(string name) void {
     this.name = name
     screen("Hello " + this.name)
  }

  private twice() int {
    return this.secret * 2
  }

  setSecret(int value) void {
    this.secret = value
  }

  revealSecret() int {
    return this.twice()
  }

  thread run(int n) {
    screen("thread run " + String(n))
  }
}

export (Person)
export (User)


# module_deps.zen

struct Address {
  string city

  show() void {
    screen("City: " + this.city)
  }
}

struct Employee {
  string name
}

struct Company {
  string name
  Address address
  List<Employee> employees

  setup(string name, string city) void {
    this.name = name
    this.address.city = city
  }

  addEmployee(string name) void {
    Employee e = { name: name }
    this.employees.push(e)
  }

  show() void {
    screen(this.name)
    screen(this.employees.length)
  }
}

# Only Company is exported. Address and Employee are imported
# implicitly as hidden structs.
export (Company)


# module_nested.zen

const int first = 10
const int second = 20
const int third = 30
const int fourth = 40

export (first, second)
export (third)
export (fourth)
*/

screen("Modules test passed")
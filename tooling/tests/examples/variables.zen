
    byte b = 10B
    int i = 100
    long l = 1000L
    double d = 25.5
    bool active = true
    string name = "Zen"

    // constants

    const double pi_value = 3.14

    //  pi_value = 45.7 // reassignment of constants variables are compile time error

    // auto inference

    auto x = 10
    auto y = x + 20
    screen(type(x))
    screen(y)

    List<int> nums = [10, i]

    const List<int> REG_NO = [1, 2, 3]

    struct Foo {
      int value

      getValue() int {
         return this.value
      }
    }

    Foo f = {
      value: 600
    }

    const Foo foo = {
       value: 1000
    }

    // print values
    
    screen(b)
    screen(i)
    screen(l)
    screen(d)
    screen(active)
    screen(name)

    // list access
    
    screen(nums[0])

    // of loop
    loop (v of nums) screen(v)

    // pretty print
    
    debug.pretty(nums)

    // struct access
    
    screen(f.value)

    // method call

    screen(f.getValue())
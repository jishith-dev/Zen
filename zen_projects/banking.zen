struct Banking {
  int balance
  
  deposit(int a) {
if (a <= 0) sys.panic("cannot deposit 0 or negative value")
  this.balance += a
}

getBalance() int {
  return this.balance
}

withdraw(int a) {
if (a > this.balance) sys.panic("cannot withdraw more than in balance")
this.balance -= a
}
}

Banking user

user.balance = 1000 // initial balance 

user.deposit(Int(input("Enter deposit amount: ")))

screen(`Balance: ${user.getBalance()}`)

user.withdraw(Int(input("Enter amount to withdraw: ")))

screen(`Remaining balance after withdraw: ${user.getBalance()}`)